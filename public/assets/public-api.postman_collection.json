{
  "info": {
    "name": "Channeling Public API",
    "description": "OAuth2 client credentials, sessions, bookings, and doctor mobile app auth. For public API: get token first, then Bearer on protected routes. For doctor app auth: use the Doctor App Auth folder (separate JWT in doctor_access_token).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "client_id", "value": "" },
    { "key": "client_secret", "value": "" },
    { "key": "access_token", "value": "" },
    { "key": "session_id", "value": "" },
    { "key": "doctor_email", "value": "", "description": "Doctor user email OR username" },
    { "key": "doctor_password", "value": "", "description": "Doctor user password" },
    { "key": "doctor_access_token", "value": "", "description": "JWT from doctor app Login" },
    { "key": "two_factor_token", "value": "", "description": "Optional for Login when 2FA required" },
    { "key": "two_factor_code", "value": "", "description": "Optional 6-digit SMS or TOTP for Login" }
  ],
  "item": [
    {
      "name": "Create Access Token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"grant_type\": \"client_credentials\",\n  \"client_id\": \"{{client_id}}\",\n  \"client_secret\": \"{{client_secret}}\"\n}"
        },
        "url": "{{baseUrl}}/api/public/token",
        "description": "Get OAuth2 access token. Use client_id and client_secret from API client. Saves token to collection variable for use in Get Sessions."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  if (json.access_token) {",
              "    pm.collectionVariables.set('access_token', json.access_token);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Sessions",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/public/sessions?doctorCode=DR0001&fromDate=2025-02-24",
          "host": ["{{baseUrl}}"],
          "path": ["api", "public", "sessions"],
          "query": [
            { "key": "doctorCode", "value": "DR0001", "description": "Required. Doctor code." },
            { "key": "fromDate", "value": "2025-02-24", "description": "Optional. YYYY-MM-DD; default is today." }
          ]
        },
        "description": "Returns future sessions for a doctor. Requires Bearer token from Create Access Token."
      }
    },
    {
      "name": "Get Bookings",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/public/bookings?doctorCode=DR0001&sessionId={{session_id}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "public", "bookings"],
          "query": [
            { "key": "doctorCode", "value": "DR0001", "description": "Required. Doctor code." },
            { "key": "sessionId", "value": "{{session_id}}", "description": "Session id from Get Sessions (or use date instead)." },
            { "key": "date", "value": "", "disabled": true, "description": "YYYY-MM-DD — all paid bookings for doctor on this day." },
            { "key": "includePending", "value": "false", "disabled": true, "description": "Set to true to include pending (status 0) bookings." }
          ]
        },
        "description": "Returns minimal patient booking data for a doctor session or day. Paid only by default. Requires Bearer token."
      }
    },
    {
      "name": "Doctor App Auth",
      "description": "Doctor mobile login (userType 3). Set doctor_email and doctor_password, then Check Login → Login → Me. Uses doctor_access_token (not access_token).",
      "item": [
        {
          "name": "Check Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{doctor_email}}\",\n  \"password\": \"{{doctor_password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/doctor-app/auth/check-login",
            "description": "Validates credentials; returns whether 2FA is required before login."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{doctor_email}}\",\n  \"password\": \"{{doctor_password}}\",\n  \"twoFactorCode\": \"{{two_factor_code}}\",\n  \"twoFactorToken\": \"{{two_factor_token}}\"\n}"
            },
            "url": "{{baseUrl}}/api/doctor-app/auth/login",
            "description": "Completes login and returns JWT. Omit or leave empty twoFactorCode/twoFactorToken when 2FA is not required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.access_token) {",
                  "    pm.collectionVariables.set('doctor_access_token', json.access_token);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctor_access_token}}" }],
            "url": "{{baseUrl}}/api/doctor-app/auth/me",
            "description": "Requires doctor_access_token from Login. Returns user + doctor profile."
          }
        }
      ]
    }
  ]
}
