// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js" 
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  email             String             @unique()
  userType          Int                // 1 = admin, 2 = staff
  password          String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now())
  status            Int

  // ==== RELATIONS ==== //
  createdSpecialities    Speciality[]         @relation("UserCreatedSpecialities")  
  updatedSpecialities    Speciality[]         @relation("UserUpdatedSpecialities")
  createdDoctors         Doctor[]             @relation("UserCreatedDoctors")  
  updatedDoctors         Doctor[]             @relation("UserUpdatedDoctors")
}

model Department {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  description       String?
  visibility        Int                // 0 = unpublish, 1 = publish
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now())
}

model Speciality {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  code              String             @unique()
  description       String
  status            Int                // == 0: unpublish, 1: publish == //
  createdBy         String?            @db.ObjectId
  updatedBy         String?            @db.ObjectId
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now())

  // ==== RELATIONS ==== //
  doctors          Doctor[]            @relation("SpecialityToDoctor")  
  createdUser      User?               @relation("UserCreatedSpecialities", fields: [createdBy], references: [id], onDelete: SetNull) 
  updatedUser      User?               @relation("UserUpdatedSpecialities", fields: [updatedBy], references: [id], onDelete: SetNull)
}
model Doctor {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  title                String
  name                 String
  code                 String
  order                Int
  phone                String
  mobile               String
  fax                  String
  addressLine1         String
  addressLine2         String
  city                 String
  registrationNumber   String
  qualification        String
  referralCharge       Float
  sessionNoPrefix      String
  status               Int       // == 0: unpublish, 1: publish == //
  createdBy            String?   @db.ObjectId
  updatedBy            String?   @db.ObjectId
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())

  // ==== RELATIONS ==== //
  specialityId     String             @db.ObjectId
  speciality       Speciality         @relation("SpecialityToDoctor", fields: [specialityId], references: [id], onDelete: Cascade)
  createdUser      User?               @relation("UserCreatedDoctors", fields: [createdBy], references: [id], onDelete: SetNull) 
  updatedUser      User?               @relation("UserUpdatedDoctors", fields: [updatedBy], references: [id], onDelete: SetNull)
}

