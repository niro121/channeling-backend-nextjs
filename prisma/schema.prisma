// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js" 
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  email             String             @unique()
  userType          Int                // 1 = admin, 2 = staff
  password          String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now())
  status            Int
}

model Department {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  description       String?
  visibility        Int                // 0 = unpublish, 1 = publish
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now())
}