  doctorPayment           Boolean   @default(false)
  doctorPaymentAt         DateTime?
  doctorPaymentReceiptId  String?   @db.ObjectId
  doctorPaymentReceiptString String?

  // Transfer: when booking was moved to another session/doctor
  movedFromSessionId        String?   @db.ObjectId
  movedFromSession          Session?  @relation("BookingMovedFromSession", fields: [movedFromSessionId], references: [id], onDelete: SetNull)
  movedFromSessionStartTime Int?      // Original session start time (Unix sec)
  movedBy                   String?   @db.ObjectId
  movedAt                   DateTime?
  movedRemarks              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Receipt: payment/refund/doctor-payment etc. type=0 CREDIT, 1 DEBIT; method=0 REFUND, 1 PAYMENT, 2 DEBIT NOTES, 3 CREDIT NOTES, 4 DOCTOR PAYMENTS, 5 DOCTOR CANCELS
model Receipt {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  receiptNo       Int
  receiptNoString String
  paymentMethod   Int // 0 Cash, 1 Credit Card, 2 Slip, 3 Check, 4 Agent, 5 Credit
  amount          Int
  bank            String  @default("")
  bankId          String? @db.ObjectId
  cardReference   String  @default("")
  slipReference   String  @default("")
  remarks         String  @default("")
  type            Int // 0 CREDIT (decrease), 1 DEBIT (increase)
  method          Int     @default(1) // 0 REFUND, 1 PAYMENT, 2 DEBIT NOTES, 3 CREDIT NOTES, 4 DOCTOR PAYMENTS, 5 DOCTOR CANCELS
  whd             Int     @default(0)
  whdPercentage   Float   @default(0)

  bookingId         String?   @db.ObjectId
  booking           Booking?  @relation("ReceiptToBooking", fields: [bookingId], references: [id], onDelete: SetNull)
  agencyId          String?   @db.ObjectId
  agency            Agency?   @relation("AgencyToReceipt", fields: [agencyId], references: [id], onDelete: SetNull)
  creditCustomerId  String?   @db.ObjectId
  creditCustomer    CreditCustomer? @relation("CreditCustomerToReceipt", fields: [creditCustomerId], references: [id], onDelete: SetNull)
  createdBy         String?   @db.ObjectId
  shiftId           String?   @db.ObjectId
  shift             Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  locationId     String?   @db.ObjectId
  location       Location? @relation("ReceiptBillingLocation", fields: [locationId], references: [id], onDelete: SetNull)
  userLocationId String?   @db.ObjectId
  userLocation   Location? @relation("ReceiptUserLocation", fields: [userLocationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ledger cancel: when this receipt is canceled, the reversal receipt id; null if not canceled
  canceledAt        DateTime?
  canceledBy       String?   @db.ObjectId
  cancelReason     String?
  reverseReceiptId  String?   @db.ObjectId
  reversedReceiptId String?   @db.ObjectId

  // Back-office handover reconciliation: set when this receipt was ticked and reconciliation submitted
  reconciledAt        DateTime?
  reconciledBy        String?   @db.ObjectId
  reconciledHandoverId String?   @db.ObjectId

  // Index for reconciliation receipt lookup: by shift (primary) and by creator+time (legacy)
  @@index([createdBy, createdAt])
  @@index([shiftId])
}

// ==== DOUBLE-ENTRY ACCOUNTING ==== //
enum AccountType {
  CASH
  PAYABLE
  RECEIVABLE
  INCOME
  EXPENSE
}

model Account {
  id                  String       @id @default(auto()) @map("_id") @db.ObjectId
  code                String?      @unique
  name                String
  type                AccountType
  parentAccountId     String?      @db.ObjectId
  parentAccount       Account?     @relation("AccountParent", fields: [parentAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childAccounts       Account[]    @relation("AccountParent")
  locationId          String?      @db.ObjectId
  location            Location?    @relation("LocationToAccount", fields: [locationId], references: [id], onDelete: SetNull)
  doctorId            String?      @db.ObjectId
  doctor              Doctor?      @relation("DoctorToAccount", fields: [doctorId], references: [id], onDelete: SetNull)
  agencyId            String?      @db.ObjectId
  agency              Agency?      @relation("AgencyToAccount", fields: [agencyId], references: [id], onDelete: SetNull)
  creditCustomerId    String?      @db.ObjectId
  creditCustomer      CreditCustomer? @relation("CreditCustomerToAccount", fields: [creditCustomerId], references: [id], onDelete: SetNull)
  userId              String?      @db.ObjectId
  user                User?        @relation("UserToAccount", fields: [userId], references: [id], onDelete: SetNull)
  minBalanceAllowed   Int?         // When set, posting rejected if balance would go below this (e.g. 0 = no negative; -5000 = allowed to -50.00)
  maxBalanceAllowed   Int?         // When set, posting rejected if balance would go above this (e.g. RECEIVABLE: hard credit limit in cents)
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  journalLines    JournalLine[]
  floatRequestsFrom FloatRequest[] @relation("FloatRequestFromAccount")
  floatRequestsTo   FloatRequest[] @relation("FloatRequestToAccount")
}

model Journal {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  journalNumber  Int?       // Optional display number from sequence
  date          DateTime
  description   String     @default("")
  referenceType String?    // e.g. Receipt, Booking, Manual
  referenceId    String?    @db.ObjectId
  locationId     String?   @db.ObjectId
  location       Location? @relation("LocationToJournal", fields: [locationId], references: [id], onDelete: SetNull)
  createdBy      String?   @db.ObjectId
  createdAt      DateTime  @default(now())

  journalLines   JournalLine[]
  floatRequests FloatRequest[]
  shiftHandovers ShiftHandover[]

  @@index([date])
}

model JournalLine {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  journalId     String   @db.ObjectId
  journal       Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId     String   @db.ObjectId
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debitAmount   Int      @default(0) // In smallest unit (e.g. cents)
  creditAmount  Int      @default(0)
  memo          String?  @default("")
  /// Till breakdown: 0 = cash, 1 = card, 2 = slip (null = not a till line or legacy)
  paymentMethod Int?

  @@index([journalId])
  @@index([accountId])
  @@index([accountId, journalId])
}

model Log {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  status      LogStatus // INFO, ERROR
  name        String
  description String?
  before      String?
  after       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  // ==== RELATIONS ==== //
  agencyId    String?  @db.ObjectId
  agency      Agency?  @relation("AgencyToLog", fields: [agencyId], references: [id])
  sessionId   String?  @db.ObjectId
  session     Session? @relation("SessionToLog", fields: [sessionId], references: [id])
  createdUser User?    @relation("UserCreatedLogs", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser User?    @relation("UserUpdatedLogs", fields: [updatedBy], references: [id], onDelete: SetNull)
}

/// Atomic sequence per scope (e.g. appointment:sessionId, receipt:locationId). Use getNextSequenceNumber().
model Sequence {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  scopeKey  String   @unique
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum DiscountMethod {
  POS
  ON_CALL
  AGENT
  STAFF
  API
}

enum PaymentType {
  CASH
  CREDIT_CARD
  SLIP
  CHEQUE
}

enum LogStatus {
  INFO
  ERROR
}
// UAT (User Acceptance Testing) – results per tester, shared so anyone can see
model UatCaseResult {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  testerName  String
  testCaseId  String
  status      String   // "pass" | "fail"
  comment     String?  // issue or note
  updatedAt   DateTime @default(now())

  @@unique([testerName, testCaseId])
  @@index([testerName])
}

model UatSectionComplete {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  testerName  String
  feature     String
  completedAt DateTime @default(now())

  @@unique([testerName, feature])
  @@index([testerName])
}

model SmsTemplate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      Int?     // 0=Channel Doctor Arrival, 1=Channel Doctor Departure, 2=Channel Doctor Leave/Absent, 3=Appointment Reschedule, 4=Agent Balance, 5=Appointments count (Block wise)
  message   String
  status    Int?     // 0 = inactive, 1 = active
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmsLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  status      Int      // == 0 = sent, 1 = failed == //
  name        String
  description String?
  phone       String
  template    String
  createdAt   DateTime @default(now())
}

// Receipt templates: header/footer designed separately; main template has body + printer/size settings. Placeholders: {{name}}
model ReceiptHeaderTemplate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  content   String   // Text with placeholders: {{company_name}}, {{location_name}}, {{tel}}, {{email}}, {{web}}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  receipts  ReceiptTemplate[]
}

model ReceiptFooterTemplate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  content   String   // Text with placeholders: {{generated_by}}, {{generated_at}}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  receipts  ReceiptTemplate[]
}

model ReceiptTemplate {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String   // e.g. "Ledger Receipt - Slip"
  type             String   // ledger, agent_receipt, expenses_note, debit_note
  variant          String   // slip_printer | custom_size
  headerTemplateId String?  @db.ObjectId
  footerTemplateId String?  @db.ObjectId
  bodyContent      String   // Main body with placeholders
  paperWidthMm     Int?     // For slip_printer or custom_size (mm)
  paperHeightMm    Int?     // Optional; null = continuous roll for slip
  status           Int      @default(1) // 0 = inactive, 1 = active. One active per (type, variant) used at runtime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  headerTemplate ReceiptHeaderTemplate? @relation(fields: [headerTemplateId], references: [id], onDelete: SetNull)
  footerTemplate ReceiptFooterTemplate? @relation(fields: [footerTemplateId], references: [id], onDelete: SetNull)

  @@index([type, variant, status])
}

/// E2E test scenarios: container for ordered steps (each step = one test, e.g. booking).
model E2EScenario {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  paymentMethods  String?  // Legacy: JSON array; use steps instead for new scenarios
  bookingExtras   String?  // Legacy: JSON object; use steps instead
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  steps           E2EScenarioStep[]
}

/// One step in a scenario (e.g. "booking" test). Steps run sequentially.
model E2EScenarioStep {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  scenarioId  String       @db.ObjectId
  order       Int          // 0-based; run in this order
  type        String       // "booking" | future types
  config      String       // JSON: for booking { paymentMethods, bookingExtras }
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  scenario    E2EScenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  @@index([scenarioId])
}
