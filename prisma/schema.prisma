// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  name                   String
  email                  String   @unique()
  userType               Int // 1 = admin, 2 = staff
  password               String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now())
  status                 Int
  checkedDefaultLocation Boolean  @default(false)
  defaultLocation        String?
  defaultBookingMethod   Int?     // 0=Cash, 1=OnCall, 2=Agent, 3=Staff, 4=Card, 5=Slip (channel booking PAYMENT_METHODS id)

  // ==== RELATIONS ==== //
  createdSpecialities     Speciality[]                   @relation("UserCreatedSpecialities")
  updatedSpecialities     Speciality[]                   @relation("UserUpdatedSpecialities")
  createdDoctors          Doctor[]                       @relation("UserCreatedDoctors")
  updatedDoctors          Doctor[]                       @relation("UserUpdatedDoctors")
  createdDoctorSessions   DoctorSession[]                @relation("UserCreatedDoctorSessions")
  updatedDoctorSessions   DoctorSession[]                @relation("UserUpdatedDoctorSessions")
  createdLocations        Location[]                     @relation("UserCreatedLocations")
  updatedLocations        Location[]                     @relation("UserUpdatedLocations")
  createdRooms            Room[]                         @relation("UserCreatedRooms")
  updatedRooms            Room[]                         @relation("UserUpdatedRooms")
  createdDiscounts        Discount[]                     @relation("UserCreatedDiscounts")
  updatedDiscounts        Discount[]                     @relation("UserUpdatedDiscounts")
  createdVoucherCodes     VoucherCode[]                  @relation("UserCreatedVouchers")
  updatedVoucherCodes     VoucherCode[]                  @relation("UserUpdatedVouchers")
  agencies                Agency[]                       @relation("AgencyUser")
  createdSessions         Session[]                      @relation("UserCreatedSessions")
  updatedSessions         Session[]                      @relation("UserUpdatedSessions")
  createdLogs             Log[]                          @relation("UserCreatedLogs")
  updatedLogs             Log[]                          @relation("UserUpdatedLogs")
  createdAgencyBooks      AgencyBook[]                   @relation("UserCreatedAgencyBooks")
  updatedAgencyBooks      AgencyBook[]                   @relation("UserUpdatedAgencyBooks")
  createdBookings         Booking[]                      @relation("UserCreatedBookings")
  updatedBookings         Booking[]                      @relation("UserUpdatedBookings")
  createdTags             Tag[]                          @relation("UserCreatedTags")
  updatedTags             Tag[]                          @relation("UserUpdatedTags")
  userGroupId             String?                        @db.ObjectId
  userGroup               UserGroup?                     @relation("UserToUserGroup", fields: [userGroupId], references: [id], onDelete: SetNull)
  shifts                  Shift[]                        @relation("UserShifts")
  shiftsCreatedBy         Shift[]                        @relation("ShiftCreatedBy")
  shiftsPausedBy          Shift[]                        @relation("ShiftPausedBy")
  shiftsEndedBy           Shift[]                        @relation("ShiftEndedBy")
  activityLogs            ActivityLog[]                  @relation("UserActivityLogs")
  createdDoctorLeaves     DoctorLeave[]                  @relation("UserCreatedLeaves")
  updatedDoctorLeaves     DoctorLeave[]                  @relation("UserUpdatedLeaves")
  createdBulkPriceChanges DoctorSessionBulkPriceChange[] @relation("UserCreatedBulkPriceChanges")
  userLocationId          String?                        @db.ObjectId
  userLocation            Location?                      @relation("LocationToUser", fields: [userLocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staffId                 String?                        @unique @db.ObjectId
  staff                   Staff?                         @relation("UserToStaff", fields: [staffId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  bookingLocations        UserBookingLocation[]
}

model UserGroup {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  status      Int // 0 = inactive, 1 = active
  permissions Json // Store permissions as JSON: { "resource": { "view": true, "add": true, "edit": true, "delete": true } }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  // ==== RELATIONS ==== //
  users User[] @relation("UserToUserGroup")
}

model UserBookingLocation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // ==== RELATIONS ==== //
  userId String @db.ObjectId

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String @db.ObjectId

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId]) // prevent duplicate assignments
}

model Department {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  status          Int // 0 = unpublish, 1 = publish
  migrateSourceId String?   // Source system id (e.g. Sails) for migrate import lookup
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())

  // ==== RELATIONS ==== //
  doctorSessions DoctorSession[] @relation("SessionToDepartment")
  departments    Session[]       @relation("DepartmentToSession")

  // Indexes for list query: orderBy createdAt, filter by name (keyword search)
  @@index([createdAt(sort: Desc)])
  @@index([name])
}

model Speciality {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  code            String   @unique()
  description     String
  status          Int // == 0: unpublish, 1: publish == //
  migrateSourceId String?   // Source system id (e.g. Sails) for migrate import lookup
  createdBy       String?  @db.ObjectId
  updatedBy       String?  @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  // ==== RELATIONS ==== //
  doctors     Doctor[] @relation("SpecialityToDoctor")
  createdUser User?    @relation("UserCreatedSpecialities", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser User?    @relation("UserUpdatedSpecialities", fields: [updatedBy], references: [id], onDelete: SetNull)
}

model Doctor {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  name               String
  code               String   @unique()
  order              Int
  phone              String?
  mobile             String?
  fax                String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  registrationNumber String?
  qualification      String
  referralCharge     Float
  sessionNoPrefix    String?
  status             Int // == 0: unpublish, 1: publish == //
  migrateSourceId    String?   // Source system id (e.g. Sails) for migrate import lookup
  createdBy          String?  @db.ObjectId
  updatedBy          String?  @db.ObjectId
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())

  // ==== RELATIONS ==== //
  specialityId   String?         @db.ObjectId
  speciality     Speciality?     @relation("SpecialityToDoctor", fields: [specialityId], references: [id], onDelete: SetNull)
  doctorSessions DoctorSession[] @relation("SessionToDoctor")
  sessions       Session[]       @relation("DoctorToSession")
  bookings       Booking[]       @relation("DoctorToBooking")
  doctorLeaves   DoctorLeave[]   @relation("DoctorToLeaves")
  createdUser    User?           @relation("UserCreatedDoctors", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser    User?           @relation("UserUpdatedDoctors", fields: [updatedBy], references: [id], onDelete: SetNull)
}

model DoctorSession {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  institution           Int
  startTime             DateTime
  endTime               DateTime
  durationMinutes       Int?
  scheduleId            Int?
  startingPatientNumber Int
  maxPatientNumber      Int
  refundable            Int // == 0: No, 1: Yes == // 
  advancedBookingDays   Int
  fees                  Json
  amountLocal           Float?
  amountForeign         Float?
  applyTo               DateTime?
  dayType               Int // == 1: Sunday, 2: Monday, 3: Tuesday, 4: Wednesday, 5: Thursday, 6: Friday, 7: Saturday, 8: Specific day(eg: poya day) == //
  status                Int // == 0: unpublish, 1: publish == //
  createdBy             String?   @db.ObjectId
  updatedBy             String?   @db.ObjectId
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now())

  // ==== RELATIONS ==== //
  doctorId          String?         @db.ObjectId
  doctor            Doctor?         @relation("SessionToDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  departmentId      String?         @db.ObjectId
  department        Department?     @relation("SessionToDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  locationId        String?         @db.ObjectId
  location          Location?       @relation("SessionToLocation", fields: [locationId], references: [id], onDelete: SetNull)
  roomId            String?         @db.ObjectId
  room              Room?           @relation("SessionToRoom", fields: [roomId], references: [id], onDelete: SetNull)
  previousSessionId String?         @db.ObjectId
  previousSession   DoctorSession?  @relation("PreviousSession", fields: [previousSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  previousSessions  DoctorSession[] @relation("PreviousSession")
  createdUser       User?           @relation("UserCreatedDoctorSessions", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser       User?           @relation("UserUpdatedDoctorSessions", fields: [updatedBy], references: [id], onDelete: SetNull)
}

// Bulk price change: one record per "campaign" (name + single fee type)
model DoctorSessionBulkPriceChange {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  feeTypeId String // FEE_TYPES id e.g. "1" for Hospital Fee
  status    String // DRAFT | PROCESSED
  createdBy String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  createdUser User?                                @relation("UserCreatedBulkPriceChanges", fields: [createdBy], references: [id], onDelete: SetNull)
  rules       DoctorSessionBulkPriceChangeRule[]
  results     DoctorSessionBulkPriceChangeResult[]
}

// Rule: single condition (op + value) or range (localFeeMin..localFeeMax)
model DoctorSessionBulkPriceChangeRule {
  id                String @id @default(auto()) @map("_id") @db.ObjectId
  bulkPriceChangeId String @db.ObjectId
  localFeeOp        String // gt | gte | lt | lte | eq | range
  localFeeValue     Float // used when not range
  localFeeMin       Float? // when range: from this value
  localFeeMax       Float? // when range: to this value
  newLocalFee       Float
  newForeignFee     Float
  order             Int    @default(0) // apply first matching rule

  bulkPriceChange DoctorSessionBulkPriceChange @relation(fields: [bulkPriceChangeId], references: [id], onDelete: Cascade)
}

// Record of what changed (report) after processing
model DoctorSessionBulkPriceChangeResult {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  bulkPriceChangeId String   @db.ObjectId
  doctorSessionId   String   @db.ObjectId
  sessionName       String?
  doctorName        String?
  oldLocalFee       Float
  oldForeignFee     Float
  newLocalFee       Float
  newForeignFee     Float
  processedAt       DateTime @default(now())

  bulkPriceChange DoctorSessionBulkPriceChange @relation(fields: [bulkPriceChangeId], references: [id], onDelete: Cascade)
}

model Session {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  institution           Int
  date                  DateTime
  doctorSessionId       String
  previousDoctorSession String?
  startTime             DateTime
  endTime               DateTime
  durationMinutes       Int?
  startingPatientNumber Int
  maxPatientNumber      Int
  refundable            Int
  fees                  Json
  amountLocal           Int?
  amountForeign         Int?
  doctorArrivalTime     Json?
  doctorDepatureTime    Json?
  doctorLeaveRemark     String?
  doctorLeaveCreator    String?
  doctorLeaveCreatedAt  Int?
  status                Int // == 1: ACTIVE. 0: Session unavailable | LEAVE: Doctor leave (DoctorSession status) == //
  remarks               String?
  appointmentNo         Int      @default(0)
  isScan                Boolean  @default(false)

  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // ==== RELATIONS ==== //
  doctorId     String?     @db.ObjectId
  doctor       Doctor?     @relation("DoctorToSession", fields: [doctorId], references: [id], onDelete: SetNull)
  departmentId String?     @db.ObjectId
  department   Department? @relation("DepartmentToSession", fields: [departmentId], references: [id], onDelete: SetNull)
  locationId   String?     @db.ObjectId
  location     Location?   @relation("LocationToSession", fields: [locationId], references: [id], onDelete: SetNull)
  roomId       String?     @db.ObjectId
  room         Room?       @relation("RoomToSession", fields: [roomId], references: [id], onDelete: SetNull)
  bookings     Booking[]   @relation("SessionToBooking")
  history      Log[]       @relation("SessionToLog")
  createdUser  User?       @relation("UserCreatedSessions", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser  User?       @relation("UserUpdatedSessions", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([doctorId, date, status])
}

model DoctorLeave {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  fromDate      DateTime
  toDate        DateTime
  remarks       String?
  cancelRemarks String?
  sessions      Json?
  sendSms       Int? // == 0: no, 1: yes == //
  status        Int // == 0 = CANCEL, 1 = ACTIVE == //

  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // ==== RELATIONS ==== //
  doctorId    String @db.ObjectId
  doctor      Doctor @relation("DoctorToLeaves", fields: [doctorId], references: [id], onDelete: Cascade)
  createdUser User?  @relation("UserCreatedLeaves", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser User?  @relation("UserUpdatedLeaves", fields: [updatedBy], references: [id], onDelete: SetNull)
}

model Location {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  addressLine1    String
  addressLine2    String
  city            String
  branchType      Int
  status          Int // == 0: unpublish, 1: publish == //
  code            String   @unique()
  migrateSourceId String?   // Source system id (e.g. Sails) for migrate import lookup
  createdBy       String?  @db.ObjectId
  updatedBy       String?  @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  // ==== RELATIONS ==== //
  rooms                Room[]                @relation("LocationToRoom")
  zones                Zone[]                @relation("LocationToZone")
  agencies             Agency[]              @relation("LocationToAgency")
  doctorSessions       DoctorSession[]       @relation("SessionToLocation")
  sessions             Session[]             @relation("LocationToSession")
  bookings             Booking[]             @relation("LocationToBooking")
  receiptsBilling      Receipt[]             @relation("ReceiptBillingLocation")
  receiptsUserLocation Receipt[]             @relation("ReceiptUserLocation")
  userLocation         User[]                @relation("LocationToUser")
  bookingUsers         UserBookingLocation[]
  createdUser          User?                 @relation("UserCreatedLocations", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser          User?                 @relation("UserUpdatedLocations", fields: [updatedBy], references: [id], onDelete: SetNull)
}

model Room {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  number          String
  description     String
  status          Int // == 0: unpublish, 1: publish == //
  migrateSourceId String?   // Source system id (e.g. Sails) for migrate import lookup
  createdBy       String?  @db.ObjectId
  updatedBy       String?  @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  // ==== RELATIONS ==== //
  zoneId         String?         @db.ObjectId
  zone           Zone?           @relation("ZoneToRoom", fields: [zoneId], references: [id], onDelete: SetNull)
  locationId     String?         @db.ObjectId
  location       Location?       @relation("LocationToRoom", fields: [locationId], references: [id], onDelete: SetNull)
  doctorSessions DoctorSession[] @relation("SessionToRoom")
  sessions       Session[]       @relation("RoomToSession")
  createdUser    User?           @relation("UserCreatedRooms", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser    User?           @relation("UserUpdatedRooms", fields: [updatedBy], references: [id], onDelete: SetNull)
}

model Roster {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  departmentId          String   @db.ObjectId
  shiftsPerPersonPerDay Int
  status                Int // 0 = unpublish, 1 = publish
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now())
}

// Channel booking shift: 0 = paused, 1 = active, 3 = ended
model Shift {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  user          User      @relation("UserShifts", fields: [userId], references: [id], onDelete: Cascade)
  startedAt     DateTime  @default(now())
  endsAt        DateTime // startedAt + SHIFT_MAX_DURATION_HOURS
  status        Int // 0 = paused, 1 = active, 3 = ended
  createdAt     DateTime  @default(now())
  createdBy     String?   @db.ObjectId
  createdByUser User?     @relation("ShiftCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  pausedAt      DateTime?
  pausedBy      String?   @db.ObjectId
  pausedByUser  User?     @relation("ShiftPausedBy", fields: [pausedBy], references: [id], onDelete: SetNull)
  endedAt       DateTime?
  endedBy       String?   @db.ObjectId
  endedByUser   User?     @relation("ShiftEndedBy", fields: [endedBy], references: [id], onDelete: SetNull)
  updatedAt     DateTime  @updatedAt

  @@index([userId, status])
}

model ActivityLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Cascade)
  action     String // e.g. "shift.started", "shift.paused", "shift.ended"
  entityType String // e.g. "Shift", "Patient"
  entityId   String?  @db.ObjectId
  metadata   Json? // optional extra details
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
}

model Patient {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  name         String
  code         String?
  email        String?
  addressLine1 String?
  addressLine2 String?
  dateOfBirth  Int?
  age          Int?
  phone        String
  sex          String
  status       Int

  area   Tag?    @relation("PatientArea", fields: [areaId], references: [id])
  areaId String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
}

model Staff {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  code          String    @unique()
  title         String    @default("")
  name          String
  nic           String
  dateOfBirth   DateTime?
  gender        String    @default("")
  contactMobile String
  address       String    @default("")
  dateJoined    DateTime?
  status        Int       @default(1) // 0 = Inactive, 1 = Active

  bookingsAsStaff     Booking[] @relation("BookingStaff")
  bookingsReferred    Booking[] @relation("BookingReferredStaff")
  user                User?     @relation("UserToStaff")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId
}

model Tag {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  name            String?
  type            Int?
  status          Int?
  migrateSourceId String?   // Source system id (e.g. Sails) for migrate import lookup

  patients Patient[] @relation("PatientArea")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.ObjectId
  updatedBy String?   @db.ObjectId
  createdUser User?   @relation("UserCreatedTags", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser User?   @relation("UserUpdatedTags", fields: [updatedBy], references: [id], onDelete: SetNull)
}

model Zone {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  status          Int // 0 = unpublish, 1 = publish
  migrateSourceId String?  // Source system id (e.g. Sails) for migrate import lookup

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  // ==== RELATIONS ==== //
  rooms      Room[]   @relation("ZoneToRoom")
  locationId String?  @db.ObjectId
  location   Location? @relation("LocationToZone", fields: [locationId], references: [id], onDelete: SetNull)
}

model Discount {
  id                   String           @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  discountType         Int // 0 = percentage, 1 = fixed
  discountMethod       DiscountMethod[] // 1 = POS, 2 = on-call, 3 - agent, 4 - staff, 5 - API
  paymentType          PaymentType[] // 1 = cash, 2 = credit-card, 3 = slip, 4 = cheque
  discountValue        Int
  discountValueForeign Int
  fromDate             DateTime
  toDate               DateTime
  isVoucher            Int // 0 = no, 1 = yes
  autoApply            Boolean          @default(false)
  status               Int // 0 = unpublish, 1 = publish
  applyTo              Int              @default(0) // 0 = hospital-fee, 1 = professional-fee
  migrateSourceId      String?    // Source system id (e.g. Sails) for migrate import lookup

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  // ==== RELATIONS ==== //
  vouchers    VoucherCode[] @relation("DiscountVouchers")
  createdUser User?         @relation("UserCreatedDiscounts", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser User?         @relation("UserUpdatedDiscounts", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([status, fromDate, toDate])
  @@index([createdAt(sort: Desc)])
}

model VoucherCode {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  code   String @unique
  limit  Int
  status Int // 0 = unpublish, 1 = publish

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  // ==== RELATIONS ==== //
  discountId  String    @db.ObjectId
  discount    Discount? @relation("DiscountVouchers", fields: [discountId], references: [id], onDelete: Cascade)
  createdUser User?     @relation("UserCreatedVouchers", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser User?     @relation("UserUpdatedVouchers", fields: [updatedBy], references: [id], onDelete: SetNull)
}

model AgencyBook {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // ==== BASIC FIELDS ==== //
  bookNumber  String @unique
  startNumber String
  endNumber   String
  status      Int?

  // ==== RELATIONS ==== //
  agencyId String? @db.ObjectId
  agency   Agency? @relation("AgencyToAgencyBook", fields: [agencyId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  // ==== AUDIT FIELDS ==== //
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  // ==== USER RELATIONS ==== //
  createdUser User? @relation("UserCreatedAgencyBooks", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser User? @relation("UserUpdatedAgencyBooks", fields: [updatedBy], references: [id], onDelete: SetNull)
}

model Agency {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // ==== BASIC FIELDS ==== //
  name               String
  code               String? @unique
  chequePrintingName String
  parentAgencyId     String? @db.ObjectId

  // ==== CREDIT FIELDS ==== //
  creditLimit        Float @default(0)
  allowedCreditLimit Float @default(0)
  maxCreditLimit     Float @default(0)
  balance            Float @default(0)

  // ==== CONTACT FIELDS ==== //
  phone   String?
  mobile  String?
  fax     String?
  email   String?
  website String?
  memo    String?

  // ==== ADDRESS FIELDS ==== //
  addressLine1 String?
  addressLine2 String?
  city         String?

  // ==== CONTACT PERSON FIELDS ==== //
  contactPersonName   String
  contactPersonPhone  String?
  contactPersonMobile String?
  contactPersonEmail  String?

  // ==== SETTINGS ==== //
  sendSms         Int?    @default(0) // 0 = No, 1 = Yes
  status          Int?    @default(1) // 0 = Unpublish, 1 = Publish
  migrateSourceId String?  // Source system id (e.g. Sails) for migrate import lookup

  // ==== RELATIONS ==== //
  parentAgency  Agency?      @relation("AgencyParent", fields: [parentAgencyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childAgencies Agency[]     @relation("AgencyParent")
  userId        String?      @db.ObjectId
  user          User?        @relation("AgencyUser", fields: [userId], references: [id], onDelete: SetNull)
  agencyBooks   AgencyBook[] @relation("AgencyToAgencyBook")
  locationId    String?      @db.ObjectId
  location      Location?    @relation("LocationToAgency", fields: [locationId], references: [id], onDelete: SetNull)
  history       Log[]        @relation("AgencyToLog")
  bookings      Booking[]    @relation("AgencyToBooking")
  receipts      Receipt[]    @relation("AgencyToReceipt")

  // ==== AUDIT FIELDS ==== //
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
}

model Booking {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  title                   String
  name                    String
  phone                   String
  sex                     String
  area                    String
  remarks                 String   @default("")
  method                  Int
  sessionId               String?  @db.ObjectId
  session                 Session? @relation("SessionToBooking", fields: [sessionId], references: [id], onDelete: SetNull)
  doctorId                String   @db.ObjectId
  doctor                  Doctor   @relation("DoctorToBooking", fields: [doctorId], references: [id], onDelete: Restrict)
  amount                  Int
  discount                Int      @default(0)
  foriegner               Boolean  @default(false)
  status                  Int      @default(0)
  createdBy               String?  @db.ObjectId
  createdUser             User?    @relation("UserCreatedBookings", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy               String?  @db.ObjectId
  updatedUser             User?    @relation("UserUpdatedBookings", fields: [updatedBy], references: [id], onDelete: SetNull)
  fees                    Json
  refund                  Int      @default(0) // 0 none, 1 prof only, 2 hosp only, 3 full
  refundAmount            Int      @default(0)
  refundReason            String?
  refundReceiptId         String?  @db.ObjectId
  refundReceiptNoString   String?
  refundReceiptCreatedAt  DateTime?
  canceledAt              DateTime?
  canceledBy              String?  @db.ObjectId
  agencyRef               String?  @default("")
  agencyId                String?  @db.ObjectId
  agency                  Agency?  @relation("AgencyToBooking", fields: [agencyId], references: [id], onDelete: SetNull)
  staffId                 String?  @db.ObjectId
  staff                   Staff?   @relation("BookingStaff", fields: [staffId], references: [id], onDelete: SetNull)
  discountDivision        Json?
  hospitalFeeDiscount     Int      @default(0)
  professionsalFeeDiscount Int     @default(0)
  professionalFee         Int      @default(0)
  hospitalFee             Int      @default(0)
  referredDoctorId        String?  @db.ObjectId
  referredAgencyId        String?  @db.ObjectId
  referredStaffId         String?  @db.ObjectId
  referredStaff           Staff?   @relation("BookingReferredStaff", fields: [referredStaffId], references: [id], onDelete: SetNull)
  sessionStartTime        Int
  sessionEndTime          Int
  isScan                  Boolean  @default(false)
  locationId              String?  @db.ObjectId
  location                Location? @relation("LocationToBooking", fields: [locationId], references: [id], onDelete: SetNull)
  appointmentNo           Int
  discountId              String?  @db.ObjectId
  autoDiscountId          String?  @db.ObjectId
  receiptNo               Int?
  receiptNoString         String?
  receiptPaymentMethod    Int?
  receiptNoCreatedAt      DateTime?
  receiptNoId             String?  @db.ObjectId
  receipts                Receipt[] @relation("ReceiptToBooking")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Receipt: payment/refund/doctor-payment etc. type=0 CREDIT, 1 DEBIT; method=0 REFUND, 1 PAYMENT, 2 DEBIT NOTES, 3 CREDIT NOTES, 4 DOCTOR PAYMENTS, 5 DOCTOR CANCELS
model Receipt {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  receiptNo       Int
  receiptNoString String
  paymentMethod   Int // 0 Cash, 1 Credit Card, 2 Slip, 3 Check, 4 Agent, 5 Credit
  amount          Int
  bank            String  @default("")
  bankId          String? @db.ObjectId
  cardReference   String  @default("")
  slipReference   String  @default("")
  remarks         String  @default("")
  type            Int // 0 CREDIT (decrease), 1 DEBIT (increase)
  method          Int     @default(1) // 0 REFUND, 1 PAYMENT, 2 DEBIT NOTES, 3 CREDIT NOTES, 4 DOCTOR PAYMENTS, 5 DOCTOR CANCELS
  whd             Int     @default(0)
  whdPercentage   Float   @default(0)

  bookingId      String    @db.ObjectId
  booking        Booking   @relation("ReceiptToBooking", fields: [bookingId], references: [id], onDelete: Cascade)
  agencyId       String?   @db.ObjectId
  agency         Agency?   @relation("AgencyToReceipt", fields: [agencyId], references: [id], onDelete: SetNull)
  createdBy      String?   @db.ObjectId
  locationId     String?   @db.ObjectId
  location       Location? @relation("ReceiptBillingLocation", fields: [locationId], references: [id], onDelete: SetNull)
  userLocationId String?   @db.ObjectId
  userLocation   Location? @relation("ReceiptUserLocation", fields: [userLocationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Log {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  status      LogStatus // INFO, ERROR
  name        String
  description String?
  before      String?
  after       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  // ==== RELATIONS ==== //
  agencyId    String?  @db.ObjectId
  agency      Agency?  @relation("AgencyToLog", fields: [agencyId], references: [id])
  sessionId   String?  @db.ObjectId
  session     Session? @relation("SessionToLog", fields: [sessionId], references: [id])
  createdUser User?    @relation("UserCreatedLogs", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser User?    @relation("UserUpdatedLogs", fields: [updatedBy], references: [id], onDelete: SetNull)
}

/// Atomic sequence per scope (e.g. appointment:sessionId, receipt:locationId). Use getNextSequenceNumber().
model Sequence {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  scopeKey  String   @unique
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum DiscountMethod {
  POS
  ON_CALL
  AGENT
  STAFF
  API
}

enum PaymentType {
  CASH
  CREDIT_CARD
  SLIP
  CHEQUE
}

enum LogStatus {
  INFO
  ERROR
}
