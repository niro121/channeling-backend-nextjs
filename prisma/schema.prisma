// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  name                   String
  email                  String   @unique()
  // == username optional; unique when set. Prisma @unique would allow only one null in MongoDB, so we use a partial unique index via scripts/fix-user-username-partial-unique.ts == //
  username               String?  // == Optional; login can use email or username == //
  phone                  String?  // == Mobile number for SMS etc. (e.g. 07XXXXXXXX): 2FA == //
  userType               Int // 1 = admin, 2 = staff
  password               String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now())
  status                 Int
  checkedDefaultLocation Boolean  @default(false)
  defaultLocation        String?
  defaultBookingMethod   Int?     // 0=Cash, 1=OnCall, 2=Agent, 3=Staff, 4=Card, 5=Slip (channel booking PAYMENT_METHODS id)

  // == 2FA STATE == //
  twoFactorEnabled       Boolean @default(false) // == User turned on 2FA in Settings; only then is 2FA required at login == //
  twoFactorMethod        String?
  twoFactorSecret        String?
  twoFactorPendingSecret String? // Temporary secret during "setup at login"; moved to twoFactorSecret only after user verifies code
  twoFactorTempCode      String?
  twoFactorExpires       DateTime?
  twoFactorVerified      Boolean @default(false)
  twoFactorSkipped       Boolean @default(false) // == Legacy: when true, user can log in without 2FA == //
  mustChangePassword     Boolean @default(false) // == When true, user must set a new password on first login (admin-created account) == //

  // ==== RELATIONS ==== //
  createdSpecialities     Speciality[]                   @relation("UserCreatedSpecialities")
  updatedSpecialities     Speciality[]                   @relation("UserUpdatedSpecialities")
  createdDoctors          Doctor[]                       @relation("UserCreatedDoctors")
  updatedDoctors          Doctor[]                       @relation("UserUpdatedDoctors")
  createdDoctorSessions   DoctorSession[]                @relation("UserCreatedDoctorSessions")
  updatedDoctorSessions   DoctorSession[]                @relation("UserUpdatedDoctorSessions")
  createdLocations        Location[]                     @relation("UserCreatedLocations")
  updatedLocations        Location[]                     @relation("UserUpdatedLocations")
  createdRooms            Room[]                         @relation("UserCreatedRooms")
  updatedRooms            Room[]                         @relation("UserUpdatedRooms")
  createdDiscounts        Discount[]                     @relation("UserCreatedDiscounts")
  updatedDiscounts        Discount[]                     @relation("UserUpdatedDiscounts")
  createdVoucherCodes     VoucherCode[]                  @relation("UserCreatedVouchers")
  updatedVoucherCodes     VoucherCode[]                  @relation("UserUpdatedVouchers")
  agencies                Agency[]                       @relation("AgencyUser")
  createdAgencies         Agency[]                       @relation("UserCreatedAgencies")
  updatedAgencies         Agency[]                       @relation("UserUpdatedAgencies")
  createdCreditCustomers  CreditCustomer[]              @relation("UserCreatedCreditCustomers")
  updatedCreditCustomers  CreditCustomer[]              @relation("UserUpdatedCreditCustomers")
  createdSessions         Session[]                      @relation("UserCreatedSessions")
  updatedSessions         Session[]                      @relation("UserUpdatedSessions")
  createdLogs             Log[]                          @relation("UserCreatedLogs")
  updatedLogs             Log[]                          @relation("UserUpdatedLogs")
  createdAgencyBooks      AgencyBook[]                   @relation("UserCreatedAgencyBooks")
  updatedAgencyBooks      AgencyBook[]                   @relation("UserUpdatedAgencyBooks")
  createdBookings         Booking[]                      @relation("UserCreatedBookings")
  updatedBookings         Booking[]                      @relation("UserUpdatedBookings")
  createdTags             Tag[]                          @relation("UserCreatedTags")
  updatedTags             Tag[]                          @relation("UserUpdatedTags")
  createdZones            Zone[]                         @relation("UserCreatedZones")
  updatedZones            Zone[]                         @relation("UserUpdatedZones")
  createdDepartments      Department[]                   @relation("UserCreatedDepartments")
  updatedDepartments      Department[]                   @relation("UserUpdatedDepartments")
  createdUserGroups       UserGroup[]                    @relation("UserCreatedUserGroups")
  updatedUserGroups       UserGroup[]                    @relation("UserUpdatedUserGroups")
  userGroupId             String?                        @db.ObjectId
  userGroup               UserGroup?                     @relation("UserToUserGroup", fields: [userGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shifts                  Shift[]                        @relation("UserShifts")
  shiftsCreatedBy         Shift[]                        @relation("ShiftCreatedBy")
  shiftsPausedBy          Shift[]                        @relation("ShiftPausedBy")
  shiftsEndedBy           Shift[]                        @relation("ShiftEndedBy")
  activityLogs            ActivityLog[]                  @relation("UserActivityLogs")
  createdDoctorLeaves     DoctorLeave[]                  @relation("UserCreatedLeaves")
  updatedDoctorLeaves     DoctorLeave[]                  @relation("UserUpdatedLeaves")
  createdBulkPriceChanges DoctorSessionBulkPriceChange[] @relation("UserCreatedBulkPriceChanges")
  userLocationId          String?                        @db.ObjectId
  userLocation            Location?                      @relation("LocationToUser", fields: [userLocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // staffId optional; unique when set. Prisma @unique would allow only one null in MongoDB, so we use a partial unique index via scripts/fix-user-staffid-partial-unique.ts
  staffId                 String?                        @db.ObjectId
  staff                   Staff?                         @relation("UserToStaff", fields: [staffId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  bookingLocations        UserBookingLocation[]
  accounts                Account[]                     @relation("UserToAccount")
  floatRequestsRequested  FloatRequest[]                @relation("FloatRequestRequestedBy")
  floatRequestsAsBulkCashier FloatRequest[]             @relation("FloatRequestBulkCashier")
  floatRequestsReceived  FloatRequest[]                @relation("FloatRequestReceivedBy")
  handoversFrom          ShiftHandover[]                @relation("ShiftHandoverFrom")
  handoversTo            ShiftHandover[]                @relation("ShiftHandoverTo")
  notifications          Notification[]                 @relation("UserNotifications")
}

model UserGroup {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  status      Int // 0 = inactive, 1 = active
  permissions Json // Store permissions as JSON: { "resource": { "view": true, "add": true, "edit": true, "delete": true } }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  createdBy   String?  @db.ObjectId
  updatedBy   String?  @db.ObjectId

  // == 2FA CONFIG == //
  twoFactorEnabled Boolean @default(false)
  twoFactorMethods String[] // == 1: AUTH-APP, 2: "SMS", 3: "EMAIL" == //

  // ==== RELATIONS ==== //
  users       User[] @relation("UserToUserGroup")
  createdUser User?  @relation("UserCreatedUserGroups", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser User?  @relation("UserUpdatedUserGroups", fields: [updatedBy], references: [id], onDelete: SetNull)
}

model UserBookingLocation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // ==== RELATIONS ==== //
  userId String @db.ObjectId

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String @db.ObjectId

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId]) // prevent duplicate assignments
}

model Department {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  institution     Int?     // 0=RH, 1=RHD, 2=RHT, 3=RPS (align with DoctorSession/Session)
  status          Int // 0 = unpublish, 1 = publish
  migrateSourceId String?   // Source system id (e.g. Sails) for migrate import lookup
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())
  createdBy       String?   @db.ObjectId
  updatedBy       String?   @db.ObjectId
  createdUser     User?     @relation("UserCreatedDepartments", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser     User?     @relation("UserUpdatedDepartments", fields: [updatedBy], references: [id], onDelete: SetNull)

  // ==== RELATIONS ==== //
  doctorSessions DoctorSession[] @relation("SessionToDepartment")
  departments    Session[]       @relation("DepartmentToSession")

  // Indexes for list query: orderBy createdAt, filter by name (keyword search)
  @@index([createdAt(sort: Desc)])
  @@index([name])
}

model Speciality {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  code            String   @unique()
  description     String
  status          Int // == 0: unpublish, 1: publish == //
  migrateSourceId String?   // Source system id (e.g. Sails) for migrate import lookup
  createdBy       String?  @db.ObjectId
  updatedBy       String?  @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  // ==== RELATIONS ==== //
  doctors     Doctor[] @relation("SpecialityToDoctor")
  createdUser User?    @relation("UserCreatedSpecialities", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser User?    @relation("UserUpdatedSpecialities", fields: [updatedBy], references: [id], onDelete: SetNull)
}

model Doctor {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  name               String
  code               String   @unique()
  order              Int
  phone              String?
  mobile             String?
  fax                String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  registrationNumber String?
  qualification      String
  referralCharge     Float
  sessionNoPrefix    String?
  status             Int // == 0: unpublish, 1: publish == //
  migrateSourceId    String?   // Source system id (e.g. Sails) for migrate import lookup
  createdBy          String?  @db.ObjectId
  updatedBy          String?  @db.ObjectId
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())

  // ==== RELATIONS ==== //
  specialityId   String?         @db.ObjectId
  speciality     Speciality?     @relation("SpecialityToDoctor", fields: [specialityId], references: [id], onDelete: SetNull)
  doctorSessions DoctorSession[] @relation("SessionToDoctor")
  sessions       Session[]       @relation("DoctorToSession")
  bookings       Booking[]       @relation("DoctorToBooking")
  doctorLeaves   DoctorLeave[]   @relation("DoctorToLeaves")
  createdUser    User?           @relation("UserCreatedDoctors", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser    User?           @relation("UserUpdatedDoctors", fields: [updatedBy], references: [id], onDelete: SetNull)
  accounts       Account[]       @relation("DoctorToAccount")
}

model DoctorSession {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  institution           Int
  startTime             DateTime
  endTime               DateTime
  durationMinutes       Int?
  scheduleId            Int?
  migrateSourceId      String?   // Source system id (e.g. legacy doctor_session_id) for migrate import lookup
  startingPatientNumber Int
  maxPatientNumber      Int
  refundable            Int // == 0: No, 1: Yes == // 
  advancedBookingDays   Int
  fees                  Json
  amountLocal           Float?
  amountForeign         Float?
  applyTo               DateTime?
  dayType               Int // == 1: Sunday, 2: Monday, 3: Tuesday, 4: Wednesday, 5: Thursday, 6: Friday, 7: Saturday, 8: Specific day(eg: poya day) == //
  status                Int // == 0: unpublish, 1: publish == //
  createdBy             String?   @db.ObjectId
  updatedBy             String?   @db.ObjectId
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now())

  // ==== RELATIONS ==== //
  doctorId          String?         @db.ObjectId
  doctor            Doctor?         @relation("SessionToDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  departmentId      String?         @db.ObjectId
  department        Department?     @relation("SessionToDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  locationId        String?         @db.ObjectId
  location          Location?       @relation("SessionToLocation", fields: [locationId], references: [id], onDelete: SetNull)
  roomId            String?         @db.ObjectId
  room              Room?           @relation("SessionToRoom", fields: [roomId], references: [id], onDelete: SetNull)
  previousSessionId String?         @db.ObjectId
  previousSession   DoctorSession?  @relation("PreviousSession", fields: [previousSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  previousSessions  DoctorSession[] @relation("PreviousSession")
  createdUser       User?           @relation("UserCreatedDoctorSessions", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser       User?           @relation("UserUpdatedDoctorSessions", fields: [updatedBy], references: [id], onDelete: SetNull)
}

// Bulk price change: one record per "campaign" (name + single fee type)
model DoctorSessionBulkPriceChange {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  feeTypeId String // FEE_TYPES id e.g. "1" for Hospital Fee
  status    String // DRAFT | PROCESSED
  createdBy String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  createdUser User?                                @relation("UserCreatedBulkPriceChanges", fields: [createdBy], references: [id], onDelete: SetNull)
  rules       DoctorSessionBulkPriceChangeRule[]
  results     DoctorSessionBulkPriceChangeResult[]
}

// Rule: single condition (op + value) or range (localFeeMin..localFeeMax)
model DoctorSessionBulkPriceChangeRule {
  id                String @id @default(auto()) @map("_id") @db.ObjectId
  bulkPriceChangeId String @db.ObjectId
  localFeeOp        String // gt | gte | lt | lte | eq | range
  localFeeValue     Float // used when not range
  localFeeMin       Float? // when range: from this value
  localFeeMax       Float? // when range: to this value
  newLocalFee       Float
  newForeignFee     Float
  order             Int    @default(0) // apply first matching rule

  bulkPriceChange DoctorSessionBulkPriceChange @relation(fields: [bulkPriceChangeId], references: [id], onDelete: Cascade)
}

// Record of what changed (report) after processing
model DoctorSessionBulkPriceChangeResult {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  bulkPriceChangeId String   @db.ObjectId
  doctorSessionId   String   @db.ObjectId
  sessionName       String?
  doctorName        String?
  oldLocalFee       Float
  oldForeignFee     Float
  newLocalFee       Float
  newForeignFee     Float
  processedAt       DateTime @default(now())

  bulkPriceChange DoctorSessionBulkPriceChange @relation(fields: [bulkPriceChangeId], references: [id], onDelete: Cascade)
}

model Session {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  institution           Int
  date                  DateTime
  doctorSessionId       String
  previousDoctorSession String?
  startTime             DateTime
  endTime               DateTime
  durationMinutes       Int?
  startingPatientNumber Int
  maxPatientNumber      Int
  refundable            Int
  fees                  Json
  amountLocal           Int?
  amountForeign         Int?
  doctorArrivalTime     Json?
  doctorDepatureTime    Json?
  doctorLeaveRemark     String?
  doctorLeaveCreator    String?
  doctorLeaveCreatedAt  Int?
  status                Int // == 1: ACTIVE. 0: Session unavailable | LEAVE: Doctor leave (DoctorSession status) == //
  remarks               String?
  appointmentNo         Int      @default(0)
  isScan                Boolean  @default(false)

  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // ==== RELATIONS ==== //
  doctorId     String?     @db.ObjectId
  doctor       Doctor?     @relation("DoctorToSession", fields: [doctorId], references: [id], onDelete: SetNull)
  departmentId String?     @db.ObjectId
  department   Department? @relation("DepartmentToSession", fields: [departmentId], references: [id], onDelete: SetNull)
  locationId   String?     @db.ObjectId
  location     Location?   @relation("LocationToSession", fields: [locationId], references: [id], onDelete: SetNull)
  roomId       String?     @db.ObjectId
  room         Room?       @relation("RoomToSession", fields: [roomId], references: [id], onDelete: SetNull)
  bookings         Booking[]   @relation("SessionToBooking")
  movedFromBookings Booking[]   @relation("BookingMovedFromSession")
  history          Log[]       @relation("SessionToLog")
  createdUser      User?       @relation("UserCreatedSessions", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser      User?       @relation("UserUpdatedSessions", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([doctorId, date, status])
}

model DoctorLeave {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  fromDate      DateTime
  toDate        DateTime
  remarks       String?
  cancelRemarks String?
  sessions      Json?
  sendSms       Int? // == 0: no, 1: yes == //
  status        Int // == 0 = On Leave, 1 = Leave Cancelled == //

  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // ==== RELATIONS ==== //
  doctorId    String @db.ObjectId
  doctor      Doctor @relation("DoctorToLeaves", fields: [doctorId], references: [id], onDelete: Cascade)
  createdUser User?  @relation("UserCreatedLeaves", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser User?  @relation("UserUpdatedLeaves", fields: [updatedBy], references: [id], onDelete: SetNull)
}

model Location {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  addressLine1    String
  addressLine2    String
  city            String
  branchType      Int
  status          Int // == 0: unpublish, 1: publish == //
  code            String   @unique()
  migrateSourceId String?   // Source system id (e.g. Sails) for migrate import lookup
  createdBy       String?  @db.ObjectId
  updatedBy       String?  @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  // ==== RELATIONS ==== //
  rooms                Room[]                @relation("LocationToRoom")
  zones                Zone[]                @relation("LocationToZone")
  agencies             Agency[]              @relation("LocationToAgency")
  doctorSessions       DoctorSession[]       @relation("SessionToLocation")
  sessions             Session[]             @relation("LocationToSession")
  bookings             Booking[]             @relation("LocationToBooking")
  receiptsBilling      Receipt[]             @relation("ReceiptBillingLocation")
  receiptsUserLocation Receipt[]             @relation("ReceiptUserLocation")
  userLocation         User[]                @relation("LocationToUser")
  bookingUsers         UserBookingLocation[]
  createdUser          User?                 @relation("UserCreatedLocations", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser          User?                 @relation("UserUpdatedLocations", fields: [updatedBy], references: [id], onDelete: SetNull)
  accounts             Account[]             @relation("LocationToAccount")
  journals             Journal[]             @relation("LocationToJournal")
  shifts               Shift[]               @relation("ShiftToLocation")
  bankAccounts         BankAccount[]         @relation("LocationToBankAccount")
}

model BankAccount {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  accountNumber String
  bankId        String   @db.ObjectId
  bank          Tag      @relation("BankToTag", fields: [bankId], references: [id], onDelete: Restrict)
  locationId    String   @db.ObjectId
  location      Location @relation("LocationToBankAccount", fields: [locationId], references: [id], onDelete: Restrict)
  status        Int      @default(1) // 0 = inactive, 1 = active
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?  @db.ObjectId
  updatedBy     String?  @db.ObjectId

  @@index([bankId])
  @@index([locationId])
  @@index([status])
}

model Room {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  number          String
  description     String
  status          Int // == 0: unpublish, 1: publish == //
  migrateSourceId String?   // Source system id (e.g. Sails) for migrate import lookup
  createdBy       String?  @db.ObjectId
  updatedBy       String?  @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  // ==== RELATIONS ==== //
  zoneId         String?         @db.ObjectId
  zone           Zone?           @relation("ZoneToRoom", fields: [zoneId], references: [id], onDelete: SetNull)
  locationId     String?         @db.ObjectId
  location       Location?       @relation("LocationToRoom", fields: [locationId], references: [id], onDelete: SetNull)
  doctorSessions DoctorSession[] @relation("SessionToRoom")
  sessions       Session[]       @relation("RoomToSession")
  createdUser    User?           @relation("UserCreatedRooms", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedUser    User?           @relation("UserUpdatedRooms", fields: [updatedBy], references: [id], onDelete: SetNull)
}

model Roster {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  departmentId          String   @db.ObjectId
  shiftsPerPersonPerDay Int
  status                Int // 0 = unpublish, 1 = publish
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now())
}

// Channel booking shift: 0 = paused, 1 = active, 3 = ended
model Shift {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  user          User      @relation("UserShifts", fields: [userId], references: [id], onDelete: Cascade)
  locationId    String?   @db.ObjectId
  location      Location? @relation("ShiftToLocation", fields: [locationId], references: [id], onDelete: SetNull)
  startedAt     DateTime  @default(now())
  endsAt        DateTime // startedAt + SHIFT_MAX_DURATION_HOURS
  status        Int // 0 = paused, 1 = active, 2 = handover pending, 3 = ended
  createdAt     DateTime  @default(now())
  createdBy     String?   @db.ObjectId
  createdByUser User?     @relation("ShiftCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  pausedAt      DateTime?
  pausedBy      String?   @db.ObjectId
  pausedByUser  User?     @relation("ShiftPausedBy", fields: [pausedBy], references: [id], onDelete: SetNull)
  endedAt       DateTime?
  endedBy       String?   @db.ObjectId
  endedByUser   User?     @relation("ShiftEndedBy", fields: [endedBy], references: [id], onDelete: SetNull)
  updatedAt     DateTime  @updatedAt

  floatRequests FloatRequest[]
  handovers    ShiftHandover[]
  handoversReceived ShiftHandover[] @relation("HandoversReceivedByShift")
  receipts     Receipt[]

  @@index([userId, status])
  @@index([locationId])
}

// Float request: cashier requests float at shift start; bulk cashier approves/rejects
// status: 0 = PENDING, 1 = APPROVED, 2 = RECEIVED, 3 = REJECTED, 4 = CANCELLED (aligned with rest of schema)
model FloatRequest {
  id                    String             @id @default(auto()) @map("_id") @db.ObjectId
  requestedById          String             @db.ObjectId
  requestedBy            User               @relation("FloatRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  bulkCashierId          String             @db.ObjectId
  bulkCashier            User               @relation("FloatRequestBulkCashier", fields: [bulkCashierId], references: [id], onDelete: Cascade)
  status                Int                 @default(0) // 0=PENDING, 1=APPROVED, 2=RECEIVED, 3=REJECTED, 4=CANCELLED
  amountRequested       Int                 // In smallest unit (e.g. cents)
  denominationsRequested Json               // [{ "value": 5000, "count": 10 }, ...] LKR
  denominationsApproved Json?              // Set on approve; bulk cashier can change (cannot give less total)
  fromAccountId         String?             @db.ObjectId
  fromAccount           Account?            @relation("FloatRequestFromAccount", fields: [fromAccountId], references: [id], onDelete: SetNull)
  toAccountId           String?             @db.ObjectId
  toAccount             Account?            @relation("FloatRequestToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  shiftId               String?             @db.ObjectId
  shift                 Shift?              @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  approvedAt             DateTime?
  approvedBy             String?             @db.ObjectId
  rejectedAt             DateTime?
  rejectedBy             String?             @db.ObjectId
  cancelledAt            DateTime?
  cancelledBy            String?             @db.ObjectId
  rejectReason           String?
  cancelReason           String?
  reasonForLessThanRequested String?         // Required when approved amount < requested
  receiveCode            String?             // 4-digit code for cashier to confirm receipt; set on approve
  receivedAt             DateTime?
  receivedById           String?             @db.ObjectId
  receivedBy             User?               @relation("FloatRequestReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  journalId              String?             @db.ObjectId
  journal                Journal?            @relation(fields: [journalId], references: [id], onDelete: SetNull)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([bulkCashierId, status])
  @@index([requestedById])
  @@index([status])
}

// Shift handover: when ending a shift, cashier confirms till counts per method and hands over to another user
// status: 0 = PENDING, 1 = APPROVED, 2 = REJECTED, 3 = CANCELLED
model ShiftHandover {
  id                     String         @id @default(auto()) @map("_id") @db.ObjectId
  shiftId                String         @db.ObjectId
  shift                  Shift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  fromUserId             String         @db.ObjectId
  fromUser               User           @relation("ShiftHandoverFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId               String         @db.ObjectId
  toUser                 User           @relation("ShiftHandoverTo", fields: [toUserId], references: [id], onDelete: Cascade)
  toShiftId              String?        @db.ObjectId // Recipient's shift when they approved; set on approve
  toShift                Shift?         @relation("HandoversReceivedByShift", fields: [toShiftId], references: [id], onDelete: SetNull)
  status                 Int            @default(0) // 0=PENDING, 1=APPROVED, 2=REJECTED, 3=CANCELLED
  journalId              String?        @db.ObjectId
  journal                Journal?       @relation(fields: [journalId], references: [id], onDelete: SetNull)
  cashCents              Int            @default(0)
  cardCents              Int            @default(0)
  slipCents              Int            @default(0)
  checkCents             Int            @default(0)
  creditCents            Int            @default(0)
  eWalletCents           Int            @default(0)
  totalCents             Int            @default(0)
  discrepancyReason      String?        // Reason for discrepancy (required when there is a short or over > 100 cents)
  enteredBreakdown       Json?          // Cashier-entered denominations and references: { cashDenominations, cardEntries, slipEntries, ... }
  includedHandoverIds    Json?          // Array of handover ids ["id1","id2"] that the sender is passing on (chain)
  forwardedToHandoverId  String?        @db.ObjectId // Set when this handover is included in another; where the money went
  forwardedToHandover    ShiftHandover? @relation("ForwardedTo", fields: [forwardedToHandoverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  forwardedHandovers     ShiftHandover[] @relation("ForwardedTo")
  approvedAt             DateTime?
  approvedBy             String?        @db.ObjectId
  approvalComments       String?        // Optional comments when bulk cashier approves and receives
  rejectedAt             DateTime?
  rejectedBy             String?        @db.ObjectId
  rejectReason           String?
  cancelledAt            DateTime?
  cancelledBy            String?        @db.ObjectId
  createdAt              DateTime       @default(now())

  // Back-office reconciliation lifecycle: status + approved/rejected details
  // reconciliationStatus: 0=PENDING, 1=IN_RECONCILIATION, 2=RECONCILED_APPROVED, 3=RECONCILED_REJECTED
  reconciliationStatus       Int?           @default(0)
  reconciliationRequestedAt DateTime?      // When bulk cashier opened/requested reconciliation (set with IN_RECONCILIATION)
  reconciliationRequestedBy  String?       @db.ObjectId // Who requested; whose till is deducted and added to branch
  nonCashReconciledAt        DateTime?      // Set when status = RECONCILED_APPROVED
  nonCashReconciledBy        String?        @db.ObjectId
  reconciliationRejectedAt  DateTime?
  reconciliationRejectedBy   String?        @db.ObjectId
  reconciliationRejectReason String?

  @@index([shiftId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([toUserId, status])
  @@index([toShiftId])
  @@index([forwardedToHandoverId])
  @@index([nonCashReconciledAt])
  @@index([reconciliationStatus])
  @@index([reconciliationRejectedAt])
  // List by tab: filter (status, reconciliationStatus) + sort
  @@index([status, reconciliationStatus, createdAt(sort: Desc)])
  @@index([status, reconciliationStatus, nonCashReconciledAt(sort: Desc)])
  @@index([status, reconciliationStatus, reconciliationRejectedAt(sort: Desc)])
}

// In-app notification center: float/handover approvals and rejections (extensible)
model Notification {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  user          User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type          String    // e.g. float_approved, float_rejected, handover_approved, handover_rejected
  title         String
  message       String?   // optional detail
  referenceType String?   // e.g. FloatRequest, ShiftHandover
  referenceId   String?   @db.ObjectId // id of the related entity for deep link
  readAt        DateTime? // null = unread
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([userId, readAt])
  @@index([createdAt(sort: Desc)])
}

model ActivityLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Cascade)
  action     String // e.g. "shift.started", "shift.paused", "shift.ended"
  entityType String // e.g. "Shift", "Patient"
  entityId   String?  @db.ObjectId
  metadata   Json? // optional extra details
  ipAddress  String? // client IP from x-forwarded-for or x-real-ip when available
  importance String? // "low" | "medium" | "high" for retention trimming
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([importance, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model ApiClient {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
