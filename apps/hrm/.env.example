#LOCAL AUTH DB (shared across all apps)
# AUTH_DATABASE_URL="mongodb://localhost:27017/channeling-v2-db-staging?replicaSet=rs0"
AUTH_DATABASE_URL="mongodb://127.0.0.1:27017/rh-auth"

#LOCAL HRM DB
# DATABASE_URL="mongodb://localhost:27017/archmage-hrm?replicaSet=rs0"
DATABASE_URL="mongodb://127.0.0.1:27017/rh-hrm"

#STAGING AUTH DB
#AUTH_DATABASE_URL="mongodb+srv://user:pass@cluster/archmage-auth?retryWrites=true&w=majority&tls=true"

#STAGING HRM DB
#DATABASE_URL="mongodb+srv://user:pass@cluster/archmage-hrm?retryWrites=true&w=majority&tls=true"

DEFAULT_PAGE_SIZE=100
DEFAULT_PAGE=0
DEFAULT_PER_PAGE=10
# Days before effectiveTo when assignment status becomes "expiring"
PAYSHEET_ASSIGNMENT_EXPIRING_WITHIN_DAYS=30
EXPORT_LIMIT=1000

CHANNELING_BASE_URL=http://localhost:3000
# OAuth client credentials from Channeling Admin > API Clients (POST /api/public/token)
CHANNELING_API_CLIENT_ID=
CHANNELING_API_CLIENT_SECRET=

NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=

JWT_SECRET=
TOTP_SECRET=

# ==== Public Careers API (website BFF) ==== #
# POST /api/public/careers/token — OAuth2 client_credentials
# Prefer a dedicated secret; falls back to JWT_SECRET / NEXTAUTH_SECRET
PUBLIC_CAREERS_JWT_SECRET=
# Optional token lifetime in seconds (default 3600)
# PUBLIC_CAREERS_TOKEN_TTL_SEC=3600
# Comma-separated browser origins, or leave unset for *
# PUBLIC_CAREERS_CORS_ORIGINS=https://www.example.com
# Gate POST /applications (P4+); keep false until apply is ready
CAREERS_PUBLIC_APPLY_ENABLED=false

# SMTP (email send via lib/helpers/email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Archmage HRM <noreply@example.com>"

# Activity log (writes to HRM DB ActivityLog collection)
ACTIVITY_LOG_ENABLED=1
# ACTIVITY_LOG_LOW_ENABLED=1

# Staff Attendance — device / gateway punch ingest (POST /api/attendance/punches)
# Header: X-Attendance-Api-Key: <value>  OR  Authorization: Bearer <value>
ATTENDANCE_DEVICE_API_KEY=
# Optional smoke script overrides (npm run smoke:attendance)
# ATTENDANCE_BASE_URL=http://localhost:3001
# ATTENDANCE_SMOKE_RFID=

# ==== S3 / DOCUMENT STORAGE ==== #
# Private bucket for resumes, appointment letters, and other HRM files.
# Block all public access. Never set NEXT_PUBLIC_ on these.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
# Optional key prefixes (defaults: resumes / appointment-letters / documents)
# S3_RESUMES_PREFIX=resumes
# S3_APPOINTMENT_LETTERS_PREFIX=appointment-letters
# S3_DOCUMENTS_PREFIX=documents
