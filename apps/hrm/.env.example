AUTH_DATABASE_URL=mongodb+srv://user:pass@cluster/archmage_auth
DATABASE_URL=mongodb+srv://user:pass@cluster/archmage_hrm

DEFAULT_PAGE_SIZE=100

CHANNELING_BASE_URL=http://localhost:3000
# Optional static Bearer token for Channeling public API (otherwise OAuth client credentials are used)
HRM_CLIENT_TOKEN=
CHANNELING_API_CLIENT_ID=
CHANNELING_API_CLIENT_SECRET=

NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=

JWT_SECRET=
TOTP_SECRET=

# Activity log (writes to HRM DB ActivityLog collection)
ACTIVITY_LOG_ENABLED=1
# ACTIVITY_LOG_LOW_ENABLED=1