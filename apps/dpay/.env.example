AUTH_DATABASE_URL=mongodb+srv://user:pass@cluster/archmage_auth
DATABASE_URL=mongodb+srv://user:pass@cluster/archmage_dpay

NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=

JWT_SECRET=
TOTP_SECRET=

# ==== ACTIVITY LOG (optional, default: enabled) ==== #
# Set to 0/false to disable activity logging.
ACTIVITY_LOG_ENABLED=1
# Set to 0/false to skip low-importance logs (page visits/listings).
ACTIVITY_LOG_LOW_ENABLED=1

# Channeling Public API (doctors for Bill Breakdown)
CHANNELING_API_URL=http://localhost:3000
CHANNELING_API_CLIENT_ID=
CHANNELING_API_CLIENT_SECRET=

# Channeling MongoDB (same as apps/channeling DATABASE_URL).
# Used to resolve the logged-in user's User Location for receipt numbering.
CHANNELING_DATABASE_URL=mongodb+srv://user:pass@cluster/archmage_channeling

