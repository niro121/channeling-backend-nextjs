# Copy to .env and fill in your values. Do not commit .env.

# ==== DATABASE ==== #
# MongoDB connection string (local, staging, or live)
MONGODB_URI="mongodb://localhost:27017/your-db-name?replicaSet=rs0"

# ==== AUTH ==== #
NEXTAUTH_SECRET=your-nextauth-secret
OAUTH_JWT_SECRET=your-oauth-jwt-secret

# ==== PAGINATION ==== #
DEFAULT_PAGE=0
DEFAULT_PER_PAGE=10

# ==== MAX CODE ==== #
MAX_CODE=1000

# ==== CRYPTR (encryption) ==== #
CRYPTR_SECRET_KEY=your-cryptr-secret-key

# ==== SMS (optional) ==== #
DIALOG_SMS_USER=
DIALOG_SMS_PASSWORD=
MOBITEL_SMS_API_PASSWORD=
MOBITEL_SMS_URL=
MOBITEL_SMS_USER=
SMS_API_PASSWORD=
SMS_URL=
SMS_USER=

# ==== 2FA ==== #
TOTP_SECRET=your-totp-secret
TWO_FA_CODE_EXPIRY_MINUTES=5
TWO_FA_PENDING_EXPIRY_MINUTES=10

# ==== APP ==== #
TZ=Asia/Colombo
ACTIVITY_LOG_ENABLED=1
# Set to 0 or false to skip low-importance logs (e.g. page visits). Default: enabled.
# ACTIVITY_LOG_LOW_ENABLED=1
SMS_COST_PER_MESSAGE=0.35

# ==== TILL / ACCOUNTING ==== #
# Till minimum balance allowed (cents). e.g. 100000 = 1000.00 LKR
# TILL_MIN_BALANCE_ALLOWED=100000

# Max journals and statement lines per request (default 10000). Use date range for large accounts.
# STATEMENT_MAX_JOURNALS=10000

# Max rows per report (default 10000). Used for User Activity and other reports; display and export are capped.
# REPORT_MAX=10000

# ==== REPORT SAFETY LIMITS (optional) ==== #
# Global defaults for report guards.
# REPORT_MAX_RANGE_DAYS=62
# REPORT_MAX_RECORDS=20000
#
# Per-report overrides (take priority over global values):
# Doctor Appointment Count Report
# REPORT_DOCTOR_APPOINTMENT_COUNT_MAX_RANGE_DAYS=62
# REPORT_DOCTOR_APPOINTMENT_COUNT_MAX_RECORDS=20000
#
# All Cashier Summary and Detail Report
# REPORT_ALL_CASHIER_SUMMARY_DETAIL_MAX_RANGE_DAYS=62
# REPORT_ALL_CASHIER_SUMMARY_DETAIL_MAX_RECORDS=50000
#
# Cashier Summary Report
# REPORT_CASHIER_SUMMARY_MAX_RANGE_DAYS=62
# REPORT_CASHIER_SUMMARY_MAX_RECORDS=50000
#
# Agency Statement Report
# REPORT_AGENCY_STATEMENT_MAX_RANGE_DAYS=62
# REPORT_AGENCY_STATEMENT_MAX_RECORDS=20000
#
# Channel Bookings Report
# REPORT_CHANNEL_BOOKINGS_MAX_RANGE_DAYS=62
# REPORT_CHANNEL_BOOKINGS_MAX_RECORDS=30000
#
# Consultant Payments Report
# REPORT_CONSULTANT_PAYMENTS_MAX_RANGE_DAYS=62
# REPORT_CONSULTANT_PAYMENTS_MAX_RECORDS=30000
#
# Doctor Leave Report
# REPORT_DOCTOR_LEAVE_MAX_RANGE_DAYS=62
# REPORT_DOCTOR_LEAVE_MAX_RECORDS=20000
#
# API Log Report
# REPORT_API_LOG_MAX_RANGE_DAYS=31
# REPORT_API_LOG_MAX_RECORDS=20000
#
# SMS Log / SMS Activity Report
# REPORT_SMS_LOG_MAX_RANGE_DAYS=31
# REPORT_SMS_LOG_MAX_RECORDS=50000
#
# Agent Detail Report
# REPORT_AGENT_DETAIL_MAX_RANGE_DAYS=62
# REPORT_AGENT_DETAIL_MAX_RECORDS=20000
#
# User Activity Report
# REPORT_USER_ACTIVITY_MAX_RANGE_DAYS=62
#
# Channel Patient Count (Accounting Wise) Report
# REPORT_CHANNEL_PATIENT_COUNT_ACCOUNTING_WISE_MAX_RANGE_DAYS=62
# REPORT_CHANNEL_PATIENT_COUNT_ACCOUNTING_WISE_MAX_RECORDS=50000

# Withholding tax (WHT) percentage for doctor payments.
# Optional: if unset, WHT is 0% and not applied.
# Single source of truth (server-side): UI uses this same value via server props.
# WHT_PERCENTAGE=5

# Doctor payment: allowed payment methods (comma-separated codes).
# Single source of truth (server-side): UI uses this same value via server props.
# If unset, only Cash (0) is allowed.
# Codes: 0=Cash, 1=Credit Card, 2=Slip, 3=Cheque, 4=Agent, 5=Credit, 6=E-Wallet.
# DOCTOR_PAYMENT_METHODS=0,1,2

# ==== E2E (optional, testing only – do not set in production) ==== #
# Set E2E_RUN_FROM_APP=true to enable "Run end-to-end (E2E) tests" in Admin (Heroku/staging). Leave unset for production.
# E2E_RUN_FROM_APP=true
# E2E_USER_EMAIL=test@example.com
# E2E_USER_PASSWORD=secret

# ==== SEED HELPER (optional – do not set in production) ==== #
# Set SEED_HELPER=true or SEED_HELPER=1 to allow "Database seeds" in Admin (receipt templates, accounting accounts).
# When unset or false, seed actions from /admin/seed are refused. Leave unset for production.
# SEED_HELPER=true

# ==== HMIS FHIR Patient API (optional) ==== #
# Used by channel-booking "Search Patient" to look up patients in HMIS.
# Base URL without trailing slash. Example (test copy):
# HMIS_FHIR_BASE_URL=http://124.43.4.189:8010/rhLocal
# HMIS_FHIR_API_KEY=your-fhir-api-key

# ==== DEBUG (optional) ==== #
# DEBUG_TILL_STATEMENT=1
