#LOCAL AUTH DB (shared across all apps)
AUTH_DATABASE_URL="mongodb://127.0.0.1:27017/rh-auth"

#STAGING AUTH DB
#AUTH_DATABASE_URL="mongodb+srv://user:pass@cluster/archmage-auth?retryWrites=true&w=majority&tls=true"

# Channeling Public API — OAuth client credentials from Channeling Admin > API Clients
CHANNELING_API_URL=http://localhost:3000
CHANNELING_API_CLIENT_ID=
CHANNELING_API_CLIENT_SECRET=

NEXTAUTH_URL=http://localhost:3003
NEXTAUTH_SECRET=

JWT_SECRET=
TOTP_SECRET=

# SMS 2FA (optional)
MOBITEL_SMS_URL=
MOBITEL_SMS_USER=
MOBITEL_SMS_API_PASSWORD=

# Management app → channeling per-user API (same value in both apps; openssl rand -hex 32)
MANAGEMENT_APP_JWT_SECRET=

# PWA: installs running an older app version (package.json "version") reload straight away. Set for breaking releases.
MIN_APP_VERSION=

# Display name in 2FA SMS text and authenticator-app labels
NEXT_PUBLIC_APP_NAME="Ruhunu Management"

# Management domain database (tasks). A separate database on the same Atlas cluster is fine,
# e.g. mongodb+srv://USER:PASS@cluster.mongodb.net/rh-management-live?retryWrites=true&w=majority
MANAGEMENT_DATABASE_URL=

# Task emails over SMTP (any provider). Either SMTP_URL, or SMTP_HOST/PORT/USER/PASSWORD.
# Without these, task emails are skipped; in-app notifications and phone pushes still work.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ruhunu Management <tasks@ruhunuhospital.lk>"

# Recurring tasks and due/overdue reminders run inside the web dyno every 5 minutes; "false" turns that off
TASKS_WORKER=

# AI assistants (RuhunuAI / ADK). Same value as the ADK server's ADK_SERVICE_KEY — every chat goes
# through this app, which sends it as X-Service-Key. Server addresses are set per assistant in the app.
ADK_SERVICE_KEY=
