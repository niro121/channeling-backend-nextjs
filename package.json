{
  "name": "archmage",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "heroku-postbuild": "npx turbo build --filter=@archmage/$APP_NAME",
    "backfill:receipt-doctor-id": "npm run backfill:receipt-doctor-id -w @archmage/channeling"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@10.9.2"
}
